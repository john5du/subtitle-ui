# Local development environment for subtitle-ui.
# Copy to scripts/.env and fill in values (never commit scripts/.env):
#   cp scripts/.env.example scripts/.env
#
# Loaded automatically by ./scripts/dev-up.sh and ./scripts/dev-restart.sh.
# Shell-exported variables take precedence over this file.

# --- Auth ---
# ADMIN_TOKEN=change-me

# --- Media roots (defaults: ./media/movies, ./media/tv) ---
# MOVIE_MEDIA_ROOT=./media/movies
# TV_MEDIA_ROOT=./media/tv

# --- Database ---
# DB_PATH=./tmp/subtitle_manager.sqlite3
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/subtitle_ui?sslmode=disable

# --- CORS (dev-up defaults to localhost:3300 if unset) ---
# CORS_ALLOWED_ORIGINS=http://localhost:3300,http://127.0.0.1:3300

# --- SubHD (optional) ---
# SUBHD_ENABLED=true
# SUBHD_BASE_URL=https://subhd.tv
# SUBHD_PROXY=socks5://127.0.0.1:1080

# --- Sonarr (optional; enables TV season completeness + missing search) ---
# SONARR_URL=http://127.0.0.1:8989
# SONARR_API_KEY=your-sonarr-api-key
# SONARR_ENABLED=true

# --- Jellyfin (optional; subtitle notify + video play-preview stream proxy) ---
# JELLYFIN_URL=http://127.0.0.1:8096
# JELLYFIN_API_KEY=your-jellyfin-api-key
# JELLYFIN_ENABLED=true
# JELLYFIN_PATH_MAP=/host/movies:/data/movies,/host/tv:/data/tv

# --- Video stream preview tickets (requires Jellyfin; proxies static stream) ---
# STREAM_TICKET_SECRET=  # empty → derive from ADMIN_TOKEN
# STREAM_TICKET_TTL=15m

# --- Frontend (optional; only used by Next if set when FE starts) ---
# NEXT_PUBLIC_API_BASE=http://localhost:9307
